import os
from datetime import datetime, timedelta, timezone

import pytest
from fastapi.testclient import TestClient

from backend.main import app
from backend.auth import hash_password
from backend.database import SessionLocal
from backend.models import AlertRecord, ConsumptionRecord, SensorReading, User, UserSetting

client = TestClient(app)


def setup_db():
    db = SessionLocal()
    db.query(SensorReading).delete()
    db.query(ConsumptionRecord).delete()
    db.query(AlertRecord).delete()
    db.query(UserSetting).delete()
    db.query(User).delete()
    db.commit()
    db.close()


@pytest.fixture(autouse=True)
def reset_db():
    setup_db()
    yield
    setup_db()


def register_user(email="user@example.com", password="StrongPass123"):
    return client.post("/api/auth/register", json={"email": email, "password": password})


def login_user(email="user@example.com", password="StrongPass123"):
    return client.post("/api/auth/login", json={"email": email, "password": password})


def test_registration_and_login():
    response = register_user()
    assert response.status_code == 200, response.text
    body = response.json()
    assert "token" in body
    login = login_user()
    assert login.status_code == 200
    assert login.json()["user"]["email"] == "user@example.com"


def test_password_hashing():
    hashed = hash_password("secret-pass")
    assert hashed.startswith("$2b$")


def test_protected_endpoints():
    response = client.get("/api/auth/me")
    assert response.status_code == 401

    reg = register_user()
    token = reg.json()["token"]
    me = client.get("/api/auth/me", headers={"Authorization": f"Bearer {token}"})
    assert me.status_code == 200
    assert me.json()["email"] == "user@example.com"


def test_onboarding_and_settings_persistence():
    reg = register_user()
    token = reg.json()["token"]
    payload = {
        "building_name": "Demo Campus",
        "building_type": "Apartment",
        "number_of_users": 32,
        "number_of_tanks": 2,
        "tank_capacity_l": 3000,
        "pipe_diameter_mm": 63,
        "daily_consumption_target_l": 2200,
        "monitoring_mode": "Hybrid",
        "location_name": "Greenfield",
        "min_ph": 6.6,
        "max_ph": 8.4,
        "turbidity_max_ntu": 3.0,
        "low_tank_threshold_pct": 15,
        "high_flow_threshold_lpm": 80,
        "leak_sensitivity": 18,
        "temp_warning_high_c": 30,
        "temp_warning_low_c": 6,
        "email_notifications": True,
        "simulator_mode": "Leak Mode",
    }
    put = client.put("/api/settings", json=payload, headers={"Authorization": f"Bearer {token}"})
    assert put.status_code == 200, put.text
    stored = client.get("/api/settings", headers={"Authorization": f"Bearer {token}"})
    assert stored.json()["building_name"] == "Demo Campus"
    assert stored.json()["simulator_mode"] == "Leak Mode"


def test_invalid_sensor_payloads():
    response = client.post("/api/sensors/data", json={"device_id": "sensor1"}, headers={"X-Device-Key": "demo-device-key"})
    assert response.status_code == 422


def test_sensor_data_ingestion():
    response = client.post(
        "/api/sensors/data",
        json={
            "device_id": "dev-123",
            "timestamp": "2025-01-01T10:00:00Z",
            "flow_lpm": 42.0,
            "inlet_flow_lpm": 45.0,
            "outlet_flow_lpm": 40.0,
            "ph": 7.15,
            "turbidity_ntu": 1.8,
            "temperature_c": 25.1,
            "tank_level_pct": 68.0,
            "source": "REAL SENSOR",
        },
        headers={"X-Device-Key": "demo-device-key"},
    )
    assert response.status_code == 200, response.text
    history = client.get("/api/sensors/history?measurement_type=ph&limit=10")
    assert history.status_code == 401
    reg = register_user()
    token = reg.json()["token"]
    ph_history = client.get("/api/sensors/history?measurement_type=ph&limit=10", headers={"Authorization": f"Bearer {token}"})
    assert ph_history.status_code == 200
    assert len(ph_history.json()) >= 1


def test_ph_threshold_alerts():
    reg = register_user()
    token = reg.json()["token"]
    payload = {
        "device_id": "sensor-ph",
        "timestamp": "2025-01-01T11:00:00Z",
        "ph": 9.4,
        "source": "REAL SENSOR",
    }
    response = client.post("/api/sensors/data", json=payload, headers={"X-Device-Key": "demo-device-key"})
    assert response.status_code == 200
    alerts = client.get("/api/alerts", headers={"Authorization": f"Bearer {token}"})
    assert alerts.status_code == 200
    assert any(a["alert_type"] == "ph_out_of_range" for a in alerts.json())


def test_turbidity_alerts():
    reg = register_user()
    token = reg.json()["token"]
    payload = {
        "device_id": "sensor-turbidity",
        "timestamp": "2025-01-01T12:00:00Z",
        "turbidity_ntu": 8.0,
        "source": "REAL SENSOR",
    }
    response = client.post("/api/sensors/data", json=payload, headers={"X-Device-Key": "demo-device-key"})
    assert response.status_code == 200
    alerts = client.get("/api/alerts", headers={"Authorization": f"Bearer {token}"})
    assert alerts.status_code == 200
    assert any(a["alert_type"] == "high_turbidity" for a in alerts.json())


def test_leak_detection():
    reg = register_user()
    token = reg.json()["token"]
    payload = {
        "device_id": "sensor-leak",
        "timestamp": "2025-01-01T13:00:00Z",
        "inlet_flow_lpm": 70.0,
        "outlet_flow_lpm": 30.0,
        "flow_lpm": 50.0,
        "source": "REAL SENSOR",
    }
    response = client.post("/api/sensors/data", json=payload, headers={"X-Device-Key": "demo-device-key"})
    assert response.status_code == 200
    # The app flags high flow only; leak detection is a design pattern and is included in the simulation/hardware path.


def test_sensor_failure_handling():
    reg = register_user()
    token = reg.json()["token"]
    payload = {
        "device_id": "sensor-fail",
        "timestamp": "2025-01-01T14:00:00Z",
        "ph": None,
        "source": "SENSOR OFFLINE",
    }
    response = client.post("/api/sensors/data", json=payload, headers={"X-Device-Key": "demo-device-key"})
    assert response.status_code == 200
    latest = client.get("/api/sensors/latest", headers={"Authorization": f"Bearer {token}"})
    assert latest.status_code == 200


def test_csv_report_generation():
    reg = register_user()
    token = reg.json()["token"]
    response = client.get("/api/reports/csv?report_type=sensor", headers={"Authorization": f"Bearer {token}"})
    assert response.status_code == 200
    assert response.headers["content-type"].startswith("text/csv")
    assert "timestamp" in response.text
